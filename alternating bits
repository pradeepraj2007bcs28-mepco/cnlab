#include <stdio.h>
#include <stdbool.h>

bool hasAlternatingBits(int n)
{
    int prev = n & 1;
    n = n >> 1;

    while (n > 0)
    {
        int curr = n & 1;

        if (curr == prev)
            return false;

        prev = curr;
        n = n >> 1;
    }

    return true;
}

int main()
{
    int n;

    printf("Enter n: ");
    scanf("%d", &n);

    if (hasAlternatingBits(n))
        printf("true\n");
    else
        printf("false\n");

    return 0;
}

#include <stdio.h>
#include <string.h>

int main() {
   char input_string[50];
   char data[400] = ""; // Large enough to store 8 bits per character + null terminator
   int i, j, count = 0;
   int choice;

   printf("Enter text string: ");
   // Reads the full line including spaces
   fgets(input_string, sizeof(input_string), stdin);
   input_string[strcspn(input_string, "\n")] = '\0'; // Remove trailing newline

   // Convert ASCII string to binary representation
   for(i = 0; input_string[i] != '\0'; i++) {
      char ch = input_string[i];
      char bin_char[9];

      // Convert single character to 8-bit binary string
      for(j = 7; j >= 0; j--) {
         bin_char[7 - j] = (ch & (1 << j)) ? '1' : '0';
      }
      bin_char[8] = '\0';

      // Append the binary character to our main data array
      strcat(data, bin_char);
   }

   printf("\nConverted Binary Data: %s\n", data);

   printf("\n1. Even parity");
   printf("\n2. Odd parity");
   printf("\nEnter your choice: ");
   scanf("%d", &choice);

   // Count the number of 1s in the binary string
   for(i = 0; data[i] != '\0'; i++) {
      if(data[i] == '1')
         count++;
   }

   // Determine the parity bit
   char parity;
   if(choice == 1) {
      if(count % 2 == 0)
         parity = '0';
      else
         parity = '1';
   } else {
      if(count % 2 == 0)
         parity = '1';
      else
         parity = '0';
   }

   // Sender Side Output
   printf("\n--- Sender Side ---");
   printf("\nParity bit = %c", parity);
   printf("\nTransmitted data = %s%c\n", data, parity);

   // Reset and recount 1s including the transmitted parity bit
   count = 0;
   for(i = 0; data[i] != '\0'; i++) {
      if(data[i] == '1')
         count++;
   }
   if(parity == '1')
      count++;

   // Receiver Side Output & Error Detection
   printf("\n--- Receiver Side ---");
   if(choice == 1) {
      if(count % 2 == 0)
         printf("\nNo error detected\n");
      else
         printf("\nError detected\n");
   } else {
      if(count % 2 != 0)
         printf("\nNo error detected\n");
      else
         printf("\nError detected\n");
   }

   return 0;
}

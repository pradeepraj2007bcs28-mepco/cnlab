#include <stdio.h>

void calculate_the_maximum(int n, int k)
{
    int i, j;
    int max_and = 0, max_or = 0, max_xor = 0;
    int and_val, or_val, xor_val;

    for (i = 1; i <= n; i++)
    {
        for (j = i + 1; j <= n; j++)
        {
            and_val = i & j;
            or_val  = i | j;
            xor_val = i ^ j;

            if (and_val < k && and_val > max_and)
                max_and = and_val;

            if (or_val < k && or_val > max_or)
                max_or = or_val;

            if (xor_val < k && xor_val > max_xor)
                max_xor = xor_val;
        }
    }

    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main()
{
    int n, k;

    scanf("%d %d", &n, &k);

    calculate_the_maximum(n, k);

    return 0;
}

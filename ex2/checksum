#include <stdio.h>
#include <string.h>
#define MAX_LEN 200
int calculate_ones_sum(int arr[], int size) {
    int sum = 0;
    for (int i = 0; i < size; i++) {
        sum += arr[i];
    }
    while (sum > 255) {
        sum = (sum % 256) + (sum / 256);
    }
    return sum;
}
void print_binary(int val) {
    char bits[9];
    int temp = val;
    for (int j = 7; j >= 0; j--) {
        bits[j] = (temp % 2) + '0';
        temp /= 2;
    }
    bits[8] = '\0';
    printf("%s", bits);
}
int bin_to_int(char block[]) {
    int val = 0;
    for (int i = 0; i < 8; i++) {
        val = (val * 2) + (block[i] - '0');
    }
    return val;
}
int main() {
    char binary_input[MAX_LEN * 8];
    int ascii_blocks[MAX_LEN];
    int received_blocks[MAX_LEN];
    int length, total_blocks, i;
    int error_choice;
    printf("Enter binary data string: ");
    fgets(binary_input, sizeof(binary_input), stdin);
    binary_input[strcspn(binary_input, "\n")] = '\0';
    int bit_len = strlen(binary_input);
    if (bit_len == 0) {
        printf("Empty binary string entered.\n");
        return 1;
    }
    if (bit_len % 8 != 0) {
        char padded_input[MAX_LEN * 8] = "";
        int padding_needed = 8 - (bit_len % 8);
        for (i = 0; i < padding_needed; i++) {
            strcat(padded_input, "0");
        }
        strcat(padded_input, binary_input);
        strcpy(binary_input, padded_input);
        bit_len = strlen(binary_input);
    }
    length = bit_len / 8;
    for (i = 0; i < length; i++) {
        char temp_block[9];
        strncpy(temp_block, binary_input + (i * 8), 8);
        temp_block[8] = '\0';
        ascii_blocks[i] = bin_to_int(temp_block);
    }

    /* ================= SENDER'S SIDE ================= */
    printf("\n----SENDER'S SIDE----\n");
    printf("Original Data blocks parsed into 8-bit Binary:\n");
    for (i = 0; i < length; i++) {
        printf("Block %d: ", i + 1);
        print_binary(ascii_blocks[i]);
        printf(" (Decimal: %d)\n", ascii_blocks[i]);
    }
    int sum = calculate_ones_sum(ascii_blocks, length);
    int sender_checksum = 255 - sum;
    printf("\nOriginal Sender Checksum (Sum): ");
    print_binary(sum);
    printf("\nComplemented Sender Checksum   : ");
    print_binary(sender_checksum);
    printf("\n");
    ascii_blocks[length] = sender_checksum;
    total_blocks = length + 1;
    printf("\n>>> FINAL DATA TO BE TRANSMITTED (Data + Complemented Checksum) <<<\n");
    for (i = 0; i < total_blocks; i++) {
        print_binary(ascii_blocks[i]);
        if (i == length - 1) {
            printf(" | ");
        } else {
            printf(" ");
        }
    }
    printf("\n");

    /* ================= RECEIVER'S SIDE ================= */
    printf("\n----RECEIVER'S SIDE----\n");
    for (i = 0; i < total_blocks; i++) {
        received_blocks[i] = ascii_blocks[i];
    }

    printf("Induce Error Type:\n");
    printf("0. No Error\n");
    printf("1. 1-Bit Error\n");
    printf("2. 2-Bit Error\n");
    printf("Enter choice (0-2): ");
    if (scanf("%d", &error_choice) != 1) {
        printf("Invalid choice entered.\n");
        return 1;
    }

    if (error_choice == 1) {
        int block_num, bit_pos;
        printf("Enter block number to manipulate (1 to %d): ", total_blocks);
        scanf("%d", &block_num);
        printf("Enter bit position to flip (0 to 7): ");
        scanf("%d", &bit_pos);

        if (block_num >= 1 && block_num <= total_blocks && bit_pos >= 0 && bit_pos <= 7) {
            int power = 1;
            for (int p = 0; p < bit_pos; p++) power *= 2;

            int bit_val = (received_blocks[block_num - 1] / power) % 2;
            if (bit_val == 1) {
                received_blocks[block_num - 1] -= power;
            } else {
                received_blocks[block_num - 1] += power;
            }

            printf("\n[ALERT] 1-Bit error induced in Block %d at Bit %d!\n", block_num, bit_pos);
        }
    }
    else if (error_choice == 2) {
        int block_num, bit_pos1, bit_pos2;
        printf("Enter block number to manipulate (1 to %d): ", total_blocks);
        scanf("%d", &block_num);
        printf("Enter first bit position to flip (0 to 7): ");
        scanf("%d", &bit_pos1);
        printf("Enter second bit position to flip (0 to 7): ");
        scanf("%d", &bit_pos2);

        if (block_num >= 1 && block_num <= total_blocks && bit_pos1 >= 0 && bit_pos1 <= 7 && bit_pos2 >= 0 && bit_pos2 <= 7) {
            int p1 = 1, p2 = 1;
            for (int p = 0; p < bit_pos1; p++) p1 *= 2;
            for (int p = 0; p < bit_pos2; p++) p2 *= 2;

            int bit_val1 = (received_blocks[block_num - 1] / p1) % 2;
            if (bit_val1 == 1) received_blocks[block_num - 1] -= p1;
            else received_blocks[block_num - 1] += p1;

            int bit_val2 = (received_blocks[block_num - 1] / p2) % 2;
            if (bit_val2 == 1) received_blocks[block_num - 1] -= p2;
            else received_blocks[block_num - 1] += p2;

            printf("\n[ALERT] 2-Bit error induced in Block %d at Bits %d and %d!\n", block_num, bit_pos1, bit_pos2);
        }
    } else {
        printf("\n[INFO] No error induced.\n");
    }

    printf("\nReceived Packet Blocks:\n");
    for (i = 0; i < total_blocks; i++) {
        printf("Block %d: ", i + 1);
        print_binary(received_blocks[i]);
        if (i == total_blocks - 1) {
            printf(" (Received Checksum Block)");
        }
        printf("\n");
    }
    int rec_sum = calculate_ones_sum(received_blocks, total_blocks);
    int rec_complement = 255 - rec_sum;
    printf("\nReceiver calculations (Summing all blocks):\n");
    printf("Receiver Sum                : ");
    print_binary(rec_sum);
    printf("\nReceiver Complement         : ");
    print_binary(rec_complement);
    printf("\n");

    /* ================= FINAL RESULT & EXTRACTION ================= */
    if (rec_complement == 0) {
        printf("\n>>> RESULT: SUCCESS! Complemented sum is all 0s. No error detected. <<<\n");
        printf("Extracted Original Data Bits  : ");
        for (i = 0; i < length; i++) {
            print_binary(received_blocks[i]);
            printf(" ");
        }
        printf("\n");
    } else {
        printf("\n>>> RESULT: ERROR DETECTED! Complemented sum is not all 0s. Data corrupted. <<<\n");
    }

    return 0;
}

#include <stdio.h>

#define MAX 10
#define INF 999

// Helper function to print individual routing tables per router
void printRoutingTable(int dist[MAX][MAX], int nextHop[MAX][MAX], int n, const char* label) {
    printf("\n================ %s ROUTING TABLES ================\n", label);
    for (int i = 0; i < n; i++) {
        printf("\nRouting Table for Router %c:\n", 'A' + i);
        printf("Destination | Cost | Next Hop\n");
        printf("-----------------------------\n");
        for (int j = 0; j < n; j++) {
            if (dist[i][j] == INF) {
                printf("     %c      | INF  |    -\n", 'A' + j);
            } else {
                // If it is self-distance, next hop is self '-'
                if (i == j) {
                    printf("     %c      | %-4d |    -\n", 'A' + j, dist[i][j]);
                } else {
                    printf("     %c      | %-4d |    %c\n", 'A' + j, dist[i][j], 'A' + nextHop[i][j]);
                }
            }
        }
    }
}

int main() {
    int n, cost[MAX][MAX];
    int dist[MAX][MAX];
    int nextHop[MAX][MAX]; // Tracks the optimal outgoing router interface
    int i, j, k;

    printf("Enter number of routers (Max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n > MAX || n <= 0) return 1;

    printf("Rules: 0 = Self, Positive Integer = Cost, %d = No Direct Link\n", INF);
    printf("Enter the cost matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            if (scanf("%d", &cost[i][j]) != 1) return 1;
            dist[i][j] = cost[i][j];

            // Initialize Next Hop
            if (i == j || cost[i][j] == INF) {
                nextHop[i][j] = -1; // No valid path yet
            } else {
                nextHop[i][j] = j;  // Directly connected destination is the initial next hop
            }
        }
    }

    printRoutingTable(dist, nextHop, n, "INITIAL");

    // Floyd-Warshall Algorithm with Next-Hop Path Tracking
    for (k = 0; k < n; k++) {
        for (i = 0; i < n; i++) {
            for (j = 0; j < n; j++) {
                if (dist[i][k] != INF && dist[k][j] != INF) {
                    if (dist[i][j] > dist[i][k] + dist[k][j]) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                        // Route through k means next hop becomes whatever path gets us to k
                        nextHop[i][j] = nextHop[i][k];
                    }
                }
            }
        }
    }

    printRoutingTable(dist, nextHop, n, "FINAL");

    return 0;
}

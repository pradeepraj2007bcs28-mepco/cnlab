#include <stdio.h>

void stopAndWait(int n, int lost_frame, int lost_ack)
{
    int i, total = 0;

    printf("\n===== STOP-AND-WAIT ARQ =====\n");

    for (i = 0; i < n; i++)
    {
        printf("\nFrame %d transmitted\n", i);
        total++;

        if (i == lost_frame)
        {
            printf("Frame %d LOST/CORRUPTED\n", i);
            printf("Timeout occurred for Frame %d\n", i);

            printf("Frame %d retransmitted\n", i);
            total++;

            printf("Frame %d correctly received\n", i);
            printf("ACK %d received\n", i);

            lost_frame = -1; // Reset error flag
        }
        else if (i == lost_ack)
        {
            printf("Frame %d correctly received\n", i);
            printf("ACK %d LOST/CORRUPTED\n", i);
            printf("Timeout occurred at Sender for Frame %d (ACK not received)\n", i);

            printf("Frame %d retransmitted by sender\n", i);
            total++;
            printf("Receiver discards Frame %d (Duplicate)\n", i);
            printf("ACK %d retransmitted and received\n", i);

            lost_ack = -1; // Reset error flag
        }
        else
        {
            printf("Frame %d correctly received\n", i);
            printf("ACK %d received\n", i);
        }
    }

    printf("\nAll frames delivered successfully.\n");
    printf("Total transmissions = %d\n", total);
}


void goBackN(int n, int w, int lost_frame, int lost_ack)
{
    int i = 0, j, k;
    int total = 0;

    printf("\n===== GO-BACK-N ARQ =====\n");
    printf("Window Size = %d\n", w);

    while (i < n)
    {
        printf("\nTransmitting Window: ");
        for (j = i; j < i + w && j < n; j++)
            printf("%d ", j);
        printf("\n");

        for (j = i; j < i + w && j < n; j++)
        {
            printf("\nFrame %d transmitted\n", j);
            total++;

            if (j == lost_frame)
            {
                printf("Frame %d LOST/CORRUPTED\n", j);
                printf("Timeout occurred for Frame %d\n", j);
                printf("\nGo-Back-N: Retransmitting window from Frame %d\n", j);

                for (k = j; k < i + w && k < n; k++)
                {
                    printf("Frame %d retransmitted\n", k);
                    total++;
                    printf("ACK %d received\n", k);
                }
                lost_frame = -1;
                break; // Break loop to slide window up to j next round
            }
            else if (j == lost_ack)
            {
                printf("Frame %d correctly received\n", j);
                printf("ACK %d LOST/CORRUPTED\n", j);
                printf("Timeout occurred at Sender for Frame %d\n", j);
                printf("\nGo-Back-N: Retransmitting window from Frame %d due to lost ACK\n", j);

                for (k = j; k < i + w && k < n; k++)
                {
                    printf("Frame %d retransmitted\n", k);
                    total++;
                    printf("Receiver discards Frame %d (Duplicate or out of order)\n", k);
                    printf("ACK %d received\n", k);
                }
                lost_ack = -1;
                break;
            }
            else
            {
                printf("Frame %d correctly received\n", j);
                printf("ACK %d received\n", j);
            }
        }
        i = i + w;
    }

    printf("\nAll frames delivered successfully.\n");
    printf("Total transmissions = %d\n", total);
}


void selectiveRepeat(int n, int w, int lost_frame, int lost_ack)
{
    int i, j;
    int total = 0;

    printf("\n===== SELECTIVE REPEAT ARQ =====\n");
    printf("Window Size = %d\n", w);

    for (i = 0; i < n; i += w)
    {
        printf("\nTransmitting Window: ");
        for (j = i; j < i + w && j < n; j++)
            printf("%d ", j);
        printf("\n");

        for (j = i; j < i + w && j < n; j++)
        {
            printf("\nFrame %d transmitted\n", j);
            total++;

            if (j == lost_frame)
            {
                printf("Frame %d LOST/CORRUPTED\n", j);
                printf("No ACK sent for Frame %d\n", j);
            }
            else if (j == lost_ack)
            {
                printf("Frame %d correctly received\n", j);
                printf("ACK %d LOST/CORRUPTED\n", j);
            }
            else
            {
                printf("Frame %d correctly received\n", j);
                printf("ACK %d received\n", j);
            }
        }

        /* Retransmit only the specific lost item inside current window */
        if (lost_frame >= i && lost_frame < i + w)
        {
            printf("\nTimeout occurred for Frame %d\n", lost_frame);
            printf("Selective Repeat: Retransmitting only Frame %d\n", lost_frame);
            printf("Frame %d retransmitted\n", lost_frame);
            total++;
            printf("Frame %d correctly received\n", lost_frame);
            printf("ACK %d received\n", lost_frame);
            lost_frame = -1;
        }

        if (lost_ack >= i && lost_ack < i + w)
        {
            printf("\nTimeout occurred at Sender for Frame %d (ACK not received)\n", lost_ack);
            printf("Selective Repeat: Retransmitting only Frame %d\n", lost_ack);
            printf("Frame %d retransmitted\n", lost_ack);
            total++;
            printf("Receiver discards Frame %d (Duplicate data)\n", lost_ack);
            printf("ACK %d retransmitted and received\n", lost_ack);
            lost_ack = -1;
        }
    }

    printf("\nAll frames delivered successfully.\n");
    printf("Total transmissions = %d\n", total);
}


int main()
{
    int choice;
    int n, w, target_frame, error_type;
    int lost_frame = -1, lost_ack = -1;

    printf("========================================\n");
    printf("       SLIDING WINDOW PROTOCOLS\n");
    printf("========================================\n");

    printf("\n1. Stop-and-Wait ARQ");
    printf("\n2. Go-Back-N ARQ");
    printf("\n3. Selective Repeat ARQ");
    printf("\n4. Exit");

    printf("\n\nEnter your choice: ");
    scanf("%d", &choice);

    if (choice >= 1 && choice <= 3)
    {
        printf("\nEnter number of frames: ");
        scanf("%d", &n);

        if (choice == 2 || choice == 3)
        {
            printf("Enter window size: ");
            scanf("%d", &w);
            if (w <= 0 || w > n) {
                printf("Invalid window size!\n");
                return 0;
            }
        }

        printf("Enter target frame number for test: ");
        scanf("%d", &target_frame);

        if (target_frame < 0 || target_frame >= n)
        {
            printf("Invalid frame number!\n");
            return 0;
        }

        printf("Choose error type for this frame (1 = Lost Frame, 2 = Lost ACK): ");
        scanf("%d", &error_type);

        if (error_type == 1)
            lost_frame = target_frame;
        else if (error_type == 2)
            lost_ack = target_frame;
        else
        {
            printf("Invalid error choice!\n");
            return 0;
        }
    }

    switch (choice)
    {
        case 1:
            stopAndWait(n, lost_frame, lost_ack);
            break;

        case 2:
            goBackN(n, w, lost_frame, lost_ack);
            break;

        case 3:
            selectiveRepeat(n, w, lost_frame, lost_ack);
            break;

        case 4:
            printf("\nProgram terminated.\n");
            break;

        default:
            printf("\nInvalid choice!\n");
    }

    return 0;
}

#include <stdlib.h>
int* maxSlidingWindow(int* nums, int numsSize, int k, int* returnSize)
{
    // Result array
    int resultSize = numsSize - k + 1;
    int* result = (int*)malloc(resultSize * sizeof(int));

    // Deque stores indices
    int* deque = (int*)malloc(numsSize * sizeof(int));

    int front = 0;
    int rear = 0;
    int resultIndex = 0;

    for (int i = 0; i < numsSize; i++)
    {
        // Remove indices that are outside the window
        if (front < rear && deque[front] <= i - k)
        {
            front++;
        }

        // Remove smaller elements from the rear
        while (front < rear &&
               nums[deque[rear - 1]] <= nums[i])
        {
            rear--;
        }

        // Add current index
        deque[rear++] = i;

        // Start storing answers when first window is complete
        if (i >= k - 1)
        {
            result[resultIndex++] = nums[deque[front]];
        }
    }

    free(deque);

    *returnSize = resultSize;

    return result;
}

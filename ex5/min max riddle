#include <stdio.h>
#include <stdlib.h>

int* riddle(int arr_count, int* arr, int* result_count)
{
    int n = arr_count;

    int *left = (int *)malloc(n * sizeof(int));
    int *right = (int *)malloc(n * sizeof(int));
    int *stack = (int *)malloc(n * sizeof(int));

    int *ans = (int *)malloc(n * sizeof(int));

    int top;

    /*
     * Find the previous smaller element
     */
    top = -1;

    for (int i = 0; i < n; i++)
    {
        while (top >= 0 && arr[stack[top]] >= arr[i])
        {
            top--;
        }

        if (top == -1)
            left[i] = -1;
        else
            left[i] = stack[top];

        stack[++top] = i;
    }

    /*
     * Find the next smaller element
     */
    top = -1;

    for (int i = n - 1; i >= 0; i--)
    {
        while (top >= 0 && arr[stack[top]] >= arr[i])
        {
            top--;
        }

        if (top == -1)
            right[i] = n;
        else
            right[i] = stack[top];

        stack[++top] = i;
    }

    /*
     * For each element, calculate the largest
     * window where it can be the minimum.
     */
    for (int i = 0; i < n; i++)
    {
        int windowSize = right[i] - left[i] - 1;

        if (ans[windowSize - 1] < arr[i])
        {
            ans[windowSize - 1] = arr[i];
        }
    }

    /*
     * Some window sizes may not have a direct answer.
     * Fill them using the answer of the next larger window.
     */
    for (int i = n - 2; i >= 0; i--)
    {
        if (ans[i] < ans[i + 1])
        {
            ans[i] = ans[i + 1];
        }
    }

    *result_count = n;

    free(left);
    free(right);
    free(stack);

    return ans;
}

int main()
{
    int n;

    scanf("%d", &n);

    int *arr = (int *)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    int result_count;

    int *result = riddle(n, arr, &result_count);

    for (int i = 0; i < result_count; i++)
    {
        printf("%d", result[i]);

        if (i != result_count - 1)
            printf(" ");
    }

    printf("\n");

    free(arr);
    free(result);

    return 0;
}
